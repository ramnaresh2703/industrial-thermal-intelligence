# =========================================================
# NTRO Industrial Thermal Intelligence - Environment Config
# Copy this file to backend/.env and fill in your values
# =========================================================

# NASA FIRMS API Key (get free at: https://firms.modaps.eosdis.nasa.gov/api/area/)
NASA_FIRMS_MAP_KEY=your_nasa_firms_key_here

# Fast2SMS Indian Gateway API Key (get at: https://www.fast2sms.com/)
FAST2SMS_API_KEY=your_fast2sms_key_here

# Twilio (optional fallback SMS gateway)
# TWILIO_ACCOUNT_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_token
# TWILIO_PHONE_NUMBER=+1xxxxxxxxxx

# Server
BACKEND_PORT=8000
DEBUG=False
